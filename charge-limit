#!/usr/bin/env bash
# Power Pulse — read and set the battery charge limit.
#
#   charge-limit get              -> "end<TAB>start<TAB>persisted" (empty if unsupported)
#   charge-limit set <percent>    -> set the end threshold (50..100) and save it
#   charge-limit path             -> the sysfs file it would use
#
# 100 means "charge to full", which is how every driver spells "no limit":
# there is no separate off switch in the kernel interface.
#
# TWO PLACES, NOT ONE. The live ceiling is a byte in EC RAM, reached through
# the driver's sysfs attribute. It survives a warm reboot on some boards and
# not a cold one, so the chosen value is ALSO saved to
# /etc/default/power-pulse-charge-limit, which power-pulse-charge-limit.service
# re-applies at boot. Setting one without the other is the bug this file
# exists to avoid: a limit that looks set and quietly lapses.
#
# WHY A HELPER AT ALL: charge_control_end_threshold is root-owned 0644, so the
# shell plugin (running as the desktop user) cannot write it directly. This
# tries, in order: a direct write (works when a udev rule has made the
# attribute group-writable), `sudo -n`, then `pkexec`. The first that succeeds
# wins; a failure is reported loudly rather than swallowed, because a charge
# limit that silently did not apply is worse than an error.
set -uo pipefail

MIN=50
MAX=100
CONF=/etc/default/power-pulse-charge-limit

find_attr() {
  local b
  for b in /sys/class/power_supply/BAT*; do
    [[ -e $b/charge_control_end_threshold ]] || continue
    printf '%s\n' "$b/charge_control_end_threshold"
    return 0
  done
  return 1
}

# Run a shell snippet as root, cheapest route first. Never prompts on the
# first two; pkexec may, which is correct for a write the user just asked for.
as_root() {
  local snippet=$1
  if command -v sudo >/dev/null 2>&1 && sudo -n sh -c "$snippet" 2>/dev/null; then
    return 0
  fi
  if command -v pkexec >/dev/null 2>&1 && pkexec sh -c "$snippet" 2>/dev/null; then
    return 0
  fi
  return 1
}

write_attr() {
  local file=$1 value=$2
  # Direct first: no privilege needed when a udev rule owns the permissions.
  if [[ -w $file ]] && printf '%s\n' "$value" >"$file" 2>/dev/null; then
    return 0
  fi
  as_root "printf '%s\\n' '$value' > '$file'"
}

# Save the choice for boot. Rewrites CHARGE_LIMIT= in place so the file's
# comments survive; appends if the key is somehow absent.
persist() {
  local value=$1
  as_root "
    if [ -f '$CONF' ] && grep -q '^CHARGE_LIMIT=' '$CONF'; then
      sed -i 's/^CHARGE_LIMIT=.*/CHARGE_LIMIT=$value/' '$CONF'
    else
      mkdir -p \"\$(dirname '$CONF')\"
      printf 'CHARGE_LIMIT=%s\\n' '$value' >> '$CONF'
    fi"
}

persisted_value() {
  [[ -r $CONF ]] || return 0
  sed -n 's/^CHARGE_LIMIT=\([0-9]\{1,3\}\).*/\1/p' "$CONF" | tail -1
}

attr=$(find_attr) || {
  case ${1-} in
    get|path) exit 0 ;;
    *) echo "charge-limit: no charge_control_end_threshold on this machine" >&2; exit 2 ;;
  esac
}
start_attr=${attr%end_threshold}start_threshold

case ${1-get} in
  path)
    printf '%s\n' "$attr"
    ;;
  get)
    end=$(<"$attr")
    start=""
    [[ -r $start_attr ]] && start=$(<"$start_attr")
    printf '%s\t%s\t%s\n' "$end" "$start" "$(persisted_value)"
    ;;
  set)
    value=${2-}
    [[ $value =~ ^[0-9]+$ ]] || { echo "charge-limit: set needs a whole percent" >&2; exit 2; }
    (( value >= MIN && value <= MAX )) || {
      echo "charge-limit: $value% out of range ($MIN..$MAX)" >&2; exit 2; }
    write_attr "$attr" "$value" || {
      echo "charge-limit: could not write $attr (need a udev rule, passwordless sudo, or polkit)" >&2
      exit 1; }
    # Read back: the EC can clamp or ignore a value, and a silent no-op here
    # would look like a working limit that never engages.
    now=$(<"$attr")
    if [[ $now != "$value" ]]; then
      echo "charge-limit: wrote $value but the driver reports $now" >&2
      exit 1
    fi
    # The live limit is applied at this point. Persistence failing is a real
    # problem but a lesser one, so it is reported without failing the set —
    # the panel notices the mismatch and says the limit will not survive a
    # reboot, which is more useful than an error over a limit that did work.
    persist "$now" || echo "charge-limit: set $now% but could not save it to $CONF; it will not survive a reboot" >&2
    printf '%s\n' "$now"
    ;;
  *)
    echo "usage: charge-limit [get|set <percent>|path]" >&2
    exit 2
    ;;
esac
